{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyMWBl62earqjyXi3ZNW3Rlb"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":11,"metadata":{"id":"8brVMnJduQnj","executionInfo":{"status":"ok","timestamp":1794105314052,"user_tz":360,"elapsed":3649,"user":{"displayName":"Alvaro Quinones Jauregui","userId":"15331378680610133063"}}},"outputs":[],"source":["!pip install qiskit qiskit-ibm-runtime numpy matplotlib pylatexenc -q\n","\n","import numpy as np\n","import hashlib\n","import matplotlib.pyplot as plt\n","\n","from qiskit import QuantumCircuit, transpile\n","from qiskit.primitives import StatevectorSampler"]},{"cell_type":"code","source":["from qiskit_ibm_runtime import QiskitRuntimeService\n","\n","QiskitRuntimeService.save_account(\n","    token=\"oZV8t7fnSY-BP6PORUlUXl5MOp80EoDYFJcSZwZlnnKA\",\n","    instance=\"crn:v1:bluemix:public:quantum-computing:us-east:a/6bb29813e7c3465591e50ba5317ac19a:69adaa03-7300-416b-a5d5-0fd6d6e70c39::\",\n","    region=\"us-east\",\n","    set_as_default=True,\n","    overwrite=True\n",")\n","print(\"Account saved!\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"X9Fn6d22_ONn","executionInfo":{"status":"ok","timestamp":1794105325172,"user_tz":360,"elapsed":4948,"user":{"displayName":"Alvaro Quinones Jauregui","userId":"15331378680610133063"}},"outputId":"5d48908a-ba60-45d2-8f70-24f30db5557d"},"execution_count":12,"outputs":[{"output_type":"stream","name":"stdout","text":["Account saved!\n"]}]},{"cell_type":"code","source":["USE_HARDWARE = True   # Flip to True when ready for real IBM hardware\n","\n","SHOTS = 1024           # How many times each circuit runs\n","\n","# Optimal measurement angles for CHSH (in radians)\n","ANGLES = {\n","    'A0':  np.pi / 2,\n","    'A1':  0.0,\n","    'B0':  np.pi / 4,\n","    'B1': -np.pi / 4,\n","}\n","\n","# The 4 combinations and their signs in S = E(A0,B0) - E(A0,B1) + E(A1,B0) + E(A1,B1)\n","SIGNS = {\n","    ('A0', 'B0'): +1,\n","    ('A0', 'B1'): -1,\n","    ('A1', 'B0'): +1,\n","    ('A1', 'B1'): +1,\n","}"],"metadata":{"id":"cZDx6TkduUDd","executionInfo":{"status":"ok","timestamp":1794105328126,"user_tz":360,"elapsed":39,"user":{"displayName":"Alvaro Quinones Jauregui","userId":"15331378680610133063"}}},"execution_count":13,"outputs":[]},{"cell_type":"code","source":["# HOW THIS WORKS:\n","# Step 1: H gate puts qubit 0 into superposition (50% |0>, 50% |1>)\n","# Step 2: CNOT (CX) gate entangles qubit 1 with qubit 0\n","# Result: the two qubits are now in a Bell state — they are correlated\n","#         in a way that is impossible to explain classically.\n","# Step 3: RY rotations let us measure in different \"directions\" (bases).\n","\n","def build_circuit(alice_angle, bob_angle):\n","    qc = QuantumCircuit(2)\n","\n","    # Create Bell state\n","    qc.h(0)       # Hadamard: superposition\n","    qc.cx(0, 1)   # CNOT: entangle\n","\n","    # Rotate to measurement basis\n","    qc.ry(-alice_angle, 0)\n","    qc.ry(-bob_angle,   1)\n","\n","    qc.measure_all()\n","    return qc\n","\n","# Draw an example circuit to see what it looks like\n","print(\"Example circuit (settings A0, B0):\")\n","print(build_circuit(ANGLES['A0'], ANGLES['B0']).draw('text'))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"0VeCqXYKuXXj","executionInfo":{"status":"ok","timestamp":1794105331913,"user_tz":360,"elapsed":6,"user":{"displayName":"Alvaro Quinones Jauregui","userId":"15331378680610133063"}},"outputId":"48f19508-6630-479e-8099-a53e56cf70b3"},"execution_count":14,"outputs":[{"output_type":"stream","name":"stdout","text":["Example circuit (settings A0, B0):\n","        ┌───┐     ┌──────────┐ ░ ┌─┐   \n","   q_0: ┤ H ├──■──┤ Ry(-π/2) ├─░─┤M├───\n","        └───┘┌─┴─┐├──────────┤ ░ └╥┘┌─┐\n","   q_1: ─────┤ X ├┤ Ry(-π/4) ├─░──╫─┤M├\n","             └───┘└──────────┘ ░  ║ └╥┘\n","meas: 2/══════════════════════════╩══╩═\n","                                  0  1 \n"]}]},{"cell_type":"code","source":["def compute_S_and_error(backend, circuits_and_settings):\n","    E_values   = {}\n","    E_errors   = {}\n","    all_counts = {}\n","\n","    for qc, alice_key, bob_key in circuits_and_settings:\n","        label = f\"{alice_key}{bob_key}\"\n","\n","        if USE_HARDWARE:\n","            # Transpile the circuit to match the hardware's native gates\n","            qc_t   = transpile(qc, backend=backend, optimization_level=1)\n","            sampler = Sampler(backend)\n","            result  = sampler.run([qc_t], shots=SHOTS).result()\n","            counts  = result[0].data.meas.get_counts()\n","        else:\n","            from qiskit.primitives import StatevectorSampler\n","            result = StatevectorSampler().run([qc], shots=SHOTS).result()\n","            counts = result[0].data.meas.get_counts()\n","\n","        all_counts[label] = counts\n","        E = expectation_value(counts)\n","        E_values[label]   = E\n","        E_errors[label]   = np.sqrt((1 - E**2) / SHOTS)\n","\n","        print(f\"  E({alice_key},{bob_key}) = {E:+.4f}  ±{E_errors[label]:.4f}  counts: {counts}\")\n","\n","    S       = sum(sign * E_values[f\"{a}{b}\"] for (a, b), sign in SIGNS.items())\n","    sigma_S = np.sqrt(sum(e**2 for e in E_errors.values()))\n","\n","    return S, sigma_S, E_values, all_counts"],"metadata":{"id":"aPTkzMNkuaJu","executionInfo":{"status":"ok","timestamp":1794105454971,"user_tz":360,"elapsed":7,"user":{"displayName":"Alvaro Quinones Jauregui","userId":"15331378680610133063"}}},"execution_count":19,"outputs":[]},{"cell_type":"code","source":["# HOW THIS WORKS:\n","# The honest player uses the real Bell circuit (entangled qubits).\n","# Their S value will be close to 2√2 ≈ 2.828 — well above the classical bound of 2.\n","# They also publish a hash of their winner bits as a \"commitment\" —\n","# proof that they didn't change the bits after seeing results.\n","\n","def hash_bits(bitstring):\n","    return hashlib.sha256(bitstring.encode()).hexdigest()\n","\n","\n","def extract_winner_bits(all_counts):\n","    bits = \"\"\n","    for label in ['A0B0', 'A0B1', 'A1B0', 'A1B1']:\n","        most_common = max(all_counts[label], key=all_counts[label].get)\n","        bits += most_common   # 2 bits per setting → 8 bits total\n","    return bits\n","\n","\n","def run_honest_player(name, sampler):\n","    print(f\"\\n{'='*50}\")\n","    print(f\"  HONEST PLAYER: {name}\")\n","    print(f\"{'='*50}\")\n","\n","    circuits_and_settings = [\n","        (build_circuit(ANGLES[a], ANGLES[b]), a, b)\n","        for (a, b) in SIGNS.keys()\n","    ]\n","\n","    S, sigma_S, E_values, all_counts = compute_S_and_error(sampler, circuits_and_settings)\n","\n","    winner_bits = extract_winner_bits(all_counts)\n","    commitment  = hash_bits(winner_bits)\n","\n","    print(f\"\\n  S = {S:.4f}  ±{sigma_S:.4f}  (classical bound = 2.000, quantum max = {2*np.sqrt(2):.4f})\")\n","    print(f\"  Winner bits: {winner_bits}\")\n","    print(f\"  Commitment:  {commitment[:16]}...\")\n","\n","    return {\n","        'name': name, 'is_cheater': False,\n","        'S': S, 'sigma_S': sigma_S,\n","        'E_values': E_values,\n","        'winner_bits': winner_bits,\n","        'commitment': commitment,\n","        'all_counts': all_counts,\n","    }"],"metadata":{"id":"EH2qzcjqucK1","executionInfo":{"status":"ok","timestamp":1794105340929,"user_tz":360,"elapsed":3,"user":{"displayName":"Alvaro Quinones Jauregui","userId":"15331378680610133063"}}},"execution_count":16,"outputs":[]},{"cell_type":"code","source":["# HOW THIS WORKS:\n","# The cheater removes the H gate and CNOT gate — no entanglement!\n","# Their qubits are independent and classically correlated.\n","# Without entanglement, |S| <= 2 — they can't beat the classical bound.\n","# The verifier catches this in Cell 8.\n","\n","def build_rigged_circuit(alice_angle, bob_angle):\n","    qc = QuantumCircuit(2)\n","    # NO qc.h(0)    ← missing Hadamard\n","    # NO qc.cx(0,1) ← missing CNOT (no entanglement)\n","    qc.ry(-alice_angle, 0)\n","    qc.ry(-bob_angle,   1)\n","    qc.measure_all()\n","    return qc\n","\n","\n","def run_cheater(name, sampler):\n","    print(f\"\\n{'='*50}\")\n","    print(f\"  CHEATER: {name}  (skipping entanglement secretly)\")\n","    print(f\"{'='*50}\")\n","\n","    circuits_and_settings = [\n","        (build_rigged_circuit(ANGLES[a], ANGLES[b]), a, b)\n","        for (a, b) in SIGNS.keys()\n","    ]\n","\n","    S, sigma_S, E_values, all_counts = compute_S_and_error(sampler, circuits_and_settings)\n","\n","    winner_bits = extract_winner_bits(all_counts)\n","    commitment  = hash_bits(winner_bits)\n","\n","    print(f\"\\n  S = {S:.4f}  ±{sigma_S:.4f}  (should be <= 2.000 — caught!)\")\n","    print(f\"  Winner bits: {winner_bits}\")\n","    print(f\"  Commitment:  {commitment[:16]}...\")\n","\n","    return {\n","        'name': name, 'is_cheater': True,\n","        'S': S, 'sigma_S': sigma_S,\n","        'E_values': E_values,\n","        'winner_bits': winner_bits,\n","        'commitment': commitment,\n","        'all_counts': all_counts,\n","    }"],"metadata":{"id":"pPL-mDK7udWY","executionInfo":{"status":"ok","timestamp":1794105365969,"user_tz":360,"elapsed":8,"user":{"displayName":"Alvaro Quinones Jauregui","userId":"15331378680610133063"}}},"execution_count":17,"outputs":[]},{"cell_type":"code","source":["from qiskit_ibm_runtime import QiskitRuntimeService, SamplerV2 as Sampler\n","from qiskit import transpile\n","\n","if USE_HARDWARE:\n","    print(\"Connecting to IBM Quantum...\")\n","    service = QiskitRuntimeService()\n","    backend = service.least_busy(operational=True, simulator=False)\n","    print(f\"Using backend: {backend.name}\")\n","else:\n","    from qiskit.primitives import StatevectorSampler\n","    backend = None\n","\n","player_configs = [\n","    (\"Alice\",   False),\n","    (\"Bob\",     False),\n","    (\"Mallory\", True),\n","]\n","\n","players = []\n","for name, is_cheater in player_configs:\n","    if is_cheater:\n","        players.append(run_cheater(name, backend))\n","    else:\n","        players.append(run_honest_player(name, backend))\n","\n","print(f\"\\n\\nAll {len(players)} players finished!\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"x3nOBdE7ue8u","outputId":"e00921e9-fed7-4801-9f13-8798e7a11522"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Connecting to IBM Quantum...\n","Using backend: ibm_fez\n","\n","==================================================\n","  HONEST PLAYER: Alice\n","==================================================\n"]},{"output_type":"stream","name":"stderr","text":["/tmp/ipykernel_7957/1913598829.py:12: DeprecationWarning: The SamplerV2 class is deprecated as of qiskit-ibm-runtime 0.50.0 and will be removed no sooner than 3 months after the release date. `qiskit_ibm_runtime.executor_sampler.Sampler` provides a new Sampler implementation that runs all the pre- and post-processing in the client side. The top-level `qiskit_ibm_runtime.Sampler` import will be updated to point to the client-side sampler in an upcoming release, with the legacy Sampler being available until the deprecation is completed.\n","  sampler = Sampler(backend)\n"]}]},{"cell_type":"code","source":["# HOW THIS WORKS:\n","# We flag anyone whose S does NOT beat 2 by at least 5 standard deviations.\n","# 5 sigma = less than 1-in-3.5-million chance of a false accusation.\n","# We also verify the commitment hash to confirm bits weren't changed.\n","\n","SIGMA_THRESHOLD = 5.0\n","\n","def verify_player(player):\n","    S, sigma_S = player['S'], player['sigma_S']\n","    sigmas_above  = (S - 2.0) / sigma_S\n","    passes_bell   = sigmas_above >= SIGMA_THRESHOLD\n","    hash_matches  = hashlib.sha256(player['winner_bits'].encode()).hexdigest() == player['commitment']\n","    passes        = passes_bell and hash_matches\n","\n","    print(f\"\\n  Player: {player['name']}\")\n","    print(f\"    S = {S:.4f},  {sigmas_above:.1f}σ above classical bound  (need >= {SIGMA_THRESHOLD}σ)\")\n","    print(f\"    Bell test:  {'PASS ✓' if passes_bell  else 'FAIL ✗'}\")\n","    print(f\"    Hash check: {'PASS ✓' if hash_matches else 'FAIL ✗'}\")\n","    print(f\"    --> {'VERIFIED HONEST ✓' if passes else 'FLAGGED AS CHEATER ✗'}\")\n","\n","    return passes\n","\n","print(\"=\" * 50)\n","print(\"  VERIFICATION\")\n","print(\"=\" * 50)\n","\n","verified_players = [p for p in players if verify_player(p)]\n","print(f\"\\n  Honest: {[p['name'] for p in verified_players]}\")\n","print(f\"  Flagged: {[p['name'] for p in players if p not in verified_players]}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"DW_KPmS1ufZO","executionInfo":{"status":"ok","timestamp":1794104830489,"user_tz":360,"elapsed":8,"user":{"displayName":"Alvaro Quinones Jauregui","userId":"15331378680610133063"}},"outputId":"27b09437-3458-4fac-f52c-e029181816bc"},"execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":["==================================================\n","  VERIFICATION\n","==================================================\n","\n","  Player: Alice\n","    S = 2.7852,  17.5σ above classical bound  (need >= 5.0σ)\n","    Bell test:  PASS ✓\n","    Hash check: PASS ✓\n","    --> VERIFIED HONEST ✓\n","\n","  Player: Bob\n","    S = 2.7715,  17.1σ above classical bound  (need >= 5.0σ)\n","    Bell test:  PASS ✓\n","    Hash check: PASS ✓\n","    --> VERIFIED HONEST ✓\n","\n","  Player: Carol\n","    S = 2.8086,  18.2σ above classical bound  (need >= 5.0σ)\n","    Bell test:  PASS ✓\n","    Hash check: PASS ✓\n","    --> VERIFIED HONEST ✓\n","\n","  Player: Dave\n","    S = 2.7949,  17.8σ above classical bound  (need >= 5.0σ)\n","    Bell test:  PASS ✓\n","    Hash check: PASS ✓\n","    --> VERIFIED HONEST ✓\n","\n","  Player: Eve\n","    S = 2.9199,  21.5σ above classical bound  (need >= 5.0σ)\n","    Bell test:  PASS ✓\n","    Hash check: PASS ✓\n","    --> VERIFIED HONEST ✓\n","\n","  Player: Frank\n","    S = 2.8770,  20.2σ above classical bound  (need >= 5.0σ)\n","    Bell test:  PASS ✓\n","    Hash check: PASS ✓\n","    --> VERIFIED HONEST ✓\n","\n","  Player: Grace\n","    S = 2.7695,  17.1σ above classical bound  (need >= 5.0σ)\n","    Bell test:  PASS ✓\n","    Hash check: PASS ✓\n","    --> VERIFIED HONEST ✓\n","\n","  Player: Hank\n","    S = 2.8535,  19.5σ above classical bound  (need >= 5.0σ)\n","    Bell test:  PASS ✓\n","    Hash check: PASS ✓\n","    --> VERIFIED HONEST ✓\n","\n","  Player: Mallory\n","    S = 1.3398,  -12.2σ above classical bound  (need >= 5.0σ)\n","    Bell test:  FAIL ✗\n","    Hash check: PASS ✓\n","    --> FLAGGED AS CHEATER ✗\n","\n","  Player: Trudy\n","    S = 1.4648,  -10.0σ above classical bound  (need >= 5.0σ)\n","    Bell test:  FAIL ✗\n","    Hash check: PASS ✓\n","    --> FLAGGED AS CHEATER ✗\n","\n","  Honest: ['Alice', 'Bob', 'Carol', 'Dave', 'Eve', 'Frank', 'Grace', 'Hank']\n","  Flagged: ['Mallory', 'Trudy']\n"]}]},{"cell_type":"code","source":["ENTRANTS = [\"Alice\", \"Bob\", \"Mallory\"]\n","def pick_winner(verified_players, entrants):\n","    if not verified_players:\n","        print(\"No verified players — cannot pick a winner.\")\n","        return None\n","\n","    print(f\"\\n{'='*50}\")\n","    print(\"  PICKING THE WINNER\")\n","    print(f\"{'='*50}\")\n","\n","    combined = verified_players[0]['winner_bits']\n","    print(f\"  {verified_players[0]['name']}'s bits: {combined}\")\n","\n","    for p in verified_players[1:]:\n","        print(f\"  {p['name']}'s bits:  {p['winner_bits']}\")\n","        combined = ''.join(str(int(a) ^ int(b)) for a, b in zip(combined, p['winner_bits']))\n","\n","    print(f\"  XOR result: {combined}\")\n","    idx    = int(combined, 2) % len(entrants)\n","    winner = entrants[idx]\n","    print(f\"  Index {idx} of